# 神秘复苏 RAG —— 环境配置模板。复制为 .env 后按需修改。
# 默认全本地：生成与 embedding 都由 Ollama 提供，无需 API key。

RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen2.5:7b

RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=bge-m3

RAG_TEMPERATURE=0.2
RAG_TOP_K=8
RAG_CONTEXT_CHUNKS=5

# 索引默认在项目内 index/<project_id>/；如需纯 ASCII 路径可指定：
# RAG_INDEX_BASE_DIR=C:/rag_index

# ---- 可选：切换到云端生成模型（OpenAI 兼容 / MiMo）----
# 取消注释并填写你自己的 key。embedding 仍建议保留 Ollama bge-m3，
# 否则需要重建向量索引。
# RAG_LLM_PROVIDER=mimo
# RAG_LLM_API_BASE_URL=https://api.xiaomimimo.com/v1
# RAG_LLM_API_KEY=your-api-key
# RAG_LLM_MODEL=mimo-v2.5-pro
# RAG_LLM_CHAT_PATH=/v1/chat/completions
# RAG_API_PROXY=http://127.0.0.1:7890
